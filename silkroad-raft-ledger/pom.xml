<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.namnv</groupId>
        <artifactId>silkroad-raft-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>silkroad-raft-ledger</artifactId>
    <description>Dịch vụ sổ cái kép (tài khoản, chuyển tiền) chạy trên Silk Road Raft: state machine một thread, client, node và benchmark.</description>

    <dependencies>
        <dependency><groupId>com.namnv</groupId><artifactId>silkroad-raft-cluster</artifactId></dependency>
        <dependency><groupId>com.namnv</groupId><artifactId>silkroad-raft-transport</artifactId></dependency>
        <dependency><groupId>com.namnv</groupId><artifactId>silkroad-raft-client</artifactId></dependency>
        <!-- lịch sử giao dịch cũ -->
        <dependency><groupId>org.rocksdb</groupId><artifactId>rocksdbjni</artifactId></dependency>
        <!-- cổng HTTP (LedgerGateway); epoll native trên Linux, các nơi khác dùng NIO -->
        <dependency><groupId>io.netty</groupId><artifactId>netty-codec-http</artifactId></dependency>
        <dependency><groupId>io.netty</groupId><artifactId>netty-transport-native-epoll</artifactId><classifier>linux-x86_64</classifier></dependency>
        <!-- phía truy vấn (CQRS): sự kiện ghi vào cơ sở dữ liệu quan hệ qua JDBC; PostgreSQL khi chạy, H2 (chế độ PostgreSQL) trong test -->
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
        <!-- node và benchmark chạy thành tiến trình riêng: cần một backend log lúc chạy -->
        <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-slf4j2-impl</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-core</artifactId><scope>runtime</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
